<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>es.caib.emiserv</groupId>
	<artifactId>emiserv</artifactId>
	<version>2.0.7</version>
	<packaging>pom</packaging>
	<name>Emissor SCSP CAIB</name>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.18</version>
		<relativePath />
	</parent>
	<properties>
		<spring-boot.version>2.7.18</spring-boot.version>
		<liquibase.version>4.4.3</liquibase.version>
		<orika.starter.version>1.8.0</orika.starter.version>
		<reflections.version>0.9.11</reflections.version>
		<rsql.version>2.1.0</rsql.version>
		<jasperreports.version>6.21.4</jasperreports.version>
		<dynamicreports.version>6.12.1</dynamicreports.version>
		<spring-filter.version>2.1.6</spring-filter.version>
		<xdocreport.version>2.0.2</xdocreport.version>
		<opencsv.version>4.6</opencsv.version>
		<springdoc-openapi.version>1.2.25</springdoc-openapi.version>
		<keycloak.version>17.0.1</keycloak.version>
		<lombok.version>1.18.28</lombok.version>
		<scsp.core.version>5.0.12</scsp.core.version>
		<scsp.beans.version>5.0.12</scsp.beans.version>
		<scsp.emisor.version>5.0.12</scsp.emisor.version>
		<scsp.rampart.core.version>1.6.4.1</scsp.rampart.core.version>
		<scsp.emisor.demo.version>3.3.0</scsp.emisor.demo.version>

		<sitemesh.version>2.4.2</sitemesh.version>
		<commons-lang.version>2.6</commons-lang.version>
		<commons-httpclient.version>3.1</commons-httpclient.version>
		<commons-fileupload.version>1.4</commons-fileupload.version>
		<commons-beanutils.version>1.9.4</commons-beanutils.version>
		<commons-io.version>2.8.0</commons-io.version>
		<poi.version>3.15</poi.version>
		<webjars-locator.version>0.45</webjars-locator.version>
		<openapi.version>1.5.8</openapi.version>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.compiler.version>11</java.compiler.version>
		<comanda.version>1.0.0</comanda.version>
		<maven.compiler.target>${java.compiler.version}</maven.compiler.target>
		<maven.compiler.source>${java.compiler.version}</maven.compiler.source>
		<skipTests>true</skipTests>
		<!-- Interficie REACT (emiserv-back/src/main/reactapp): es construeix nomes amb el perfil "front".
		     El perfil es declara aqui i no a emiserv-back/emiserv-boot perque activar-hi un perfil amb -P
		     desactivaria els seus perfils activeByDefault (ejb_container, controladors de BBDD). -->
		<node.version>v22.13.1</node.version>
		<frontend.skip>true</frontend.skip>
	</properties>
	<modules>
		<module>emiserv-backend</module>
		<module>emiserv-controller</module>
		<module>emiserv-scsp</module>
<!--		<module>emiserv-scsp-fake</module>-->
		<module>emiserv-back</module>
		<module>emiserv-boot</module>
		<module>emiserv-ear</module>
		<module>emiserv-ejb</module>
		<module>emiserv-persistence</module>
		<module>emiserv-service</module>
		<module>emiserv-service-intf</module>
		<module>emiserv-api-interna</module>
		<module>emiserv-api-interna-scsp</module>
		<module>emiserv-api-externa</module>
		<module>emiserv-client-intf</module>
		<module>emiserv-client-jersey1</module>
		<module>emiserv-client-jersey2</module>
		<module>emiserv-client-jersey3</module>
	</modules>
	<build>
		<plugins>
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
				<version>7.0.0</version>
				<executions>
					<execution>
						<id>get-the-git-infos</id>
						<goals>
							<goal>revision</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<generateGitPropertiesFile>true</generateGitPropertiesFile>
					<gitPropertiesPath>${project.build.outputDirectory}</gitPropertiesPath>
					<includeOnlyProperties>
						<includeOnlyProperty>git.commit.id</includeOnlyProperty>
						<includeOnlyProperty>git.build.time</includeOnlyProperty>
						<includeOnlyProperty>git.build.version</includeOnlyProperty>
					</includeOnlyProperties>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>3.0.0-M2</version>
				<configuration>
					<altDeploymentRepository>internal.repo::default::file://${project.build.directory}/mvn-repo</altDeploymentRepository>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.github.github</groupId>
				<artifactId>site-maven-plugin</artifactId>
				<version>0.12</version>
				<configuration>
					<message>Maven artifacts for ${project.artifactId} v${project.version}</message>
					<outputDirectory>${project.build.directory}/mvn-repo</outputDirectory>
					<noJekyll>true</noJekyll>
					<branch>refs/heads/gh-pages</branch>
					<includes>
						<include>**/*</include>
					</includes>
					<path>maven</path>
					<repositoryName>maven</repositoryName>
					<repositoryOwner>GovernIB</repositoryOwner>
					<server>github_governib_maven</server>
					<merge>true</merge>
					<dryRun>false</dryRun>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>site</goal>
						</goals>
						<phase>deploy</phase>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<!-- Construeix el SPA de la interficie REACT (frontend-maven-plugin a emiserv-back) i l'inclou al
		     WAR i al JAR d'emiserv-boot. Amb -Dfrontend.skip=true es pot activar sense Node. -->
		<profile>
			<id>front</id>
			<properties>
				<frontend.skip>false</frontend.skip>
			</properties>
		</profile>
	</profiles>
	<distributionManagement>
		<repository>
			<id>github_governib_maven</id>
			<name>GitHub GovernIB Maven Repository</name>
			<url>file://${project.build.directory}/mvn-repo</url>
		</repository>
	</distributionManagement>
</project>
