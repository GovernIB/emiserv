<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
          http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
    version="3.0">
	<display-name>Emisor SCSP V3</display-name>

	<context-param>
		<param-name>contextConfigLocation</param-name>
		<param-value>/WEB-INF/applicationContext*.xml</param-value>
	</context-param>

	<listener>
		<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
	</listener>

	<!-- Compatibilitat amb les URLs de consulta del WSDL d'Axis2 (.../services/peticionSincrona?wsdl) -->
	<filter>
		<filter-name>wsdlCompatibilitatFilter</filter-name>
		<filter-class>es.caib.emiserv.api.interna.scsp.WsdlCompatibilitatFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>wsdlCompatibilitatFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<!-- Les peticions es despatxen segons el final de la URL: .../peticionSincrona, .../peticionAsincrona -->
	<!-- (es manté la compatibilitat amb les URLs antigues d'Axis2: /services/peticionSincrona, ...)        -->
	<servlet>
		<servlet-name>spring-emisor</servlet-name>
		<servlet-class>org.springframework.ws.transport.http.MessageDispatcherServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>spring-emisor</servlet-name>
		<url-pattern>/*</url-pattern>
	</servlet-mapping>

	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>

</web-app>
