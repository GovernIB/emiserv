{
  "realm": "GOIB",
  "enabled": true,
  "sslRequired": "none",
  "displayName": "GOIB (entorn d'integració)",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ca",
    "es"
  ],
  "defaultLocale": "ca",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 7200,
  "roles": {
    "realm": [
      {
        "name": "EMS_ADMIN",
        "description": "EMISERV: administrador"
      },
      {
        "name": "EMS_RESP",
        "description": "EMISERV: responsable de serveis"
      },
      {
        "name": "EMS_COM",
        "description": "EMISERV: API de comunicació (salut, logs, estadístiques)"
      },
      {
        "name": "EMS_REPORT",
        "description": "EMISERV: API d'informes"
      },
      {
        "name": "PBL_ADMIN",
        "description": "PINBAL: administrador"
      },
      {
        "name": "PBL_SUPERAUD",
        "description": "PINBAL: superauditor"
      },
      {
        "name": "PBL_AUDIT",
        "description": "PINBAL: auditor"
      },
      {
        "name": "PBL_REPRES",
        "description": "PINBAL: representant"
      },
      {
        "name": "PBL_WS",
        "description": "PINBAL: aplicació client (recobriment)"
      },
      {
        "name": "PBL_COM",
        "description": "PINBAL: API de comunicació"
      },
      {
        "name": "PBL_REPORT",
        "description": "PINBAL: API d'informes"
      },
      {
        "name": "tothom",
        "description": "Usuari autenticat"
      }
    ]
  },
  "clients": [
    {
      "clientId": "goib-default",
      "name": "Aplicacions web (login d'usuaris)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": ""
      },
      "protocolMappers": [
        {
          "name": "audience goib-default",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "goib-default",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "goib-ws",
      "name": "APIs REST (basic auth i compte de servei)",
      "enabled": true,
      "publicClient": false,
      "secret": "integracio-goib-ws",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience goib-ws",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "goib-ws",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
